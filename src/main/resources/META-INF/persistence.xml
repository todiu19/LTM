<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence" version="3.0">
    <persistence-unit name="examwave-pu" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>io.examwave.store.entity.TeacherEntity</class>
        <class>io.examwave.store.entity.StudentEntity</class>
        <class>io.examwave.store.entity.SubjectEntity</class>
        <class>io.examwave.store.entity.BankQuestionEntity</class>
        <class>io.examwave.store.entity.ExamTemplateEntity</class>
        <class>io.examwave.store.entity.TemplateQuestionEntity</class>
        <class>io.examwave.store.entity.ExamRoundEntity</class>
        <class>io.examwave.store.entity.RoundQuestionEntity</class>
        <class>io.examwave.store.entity.AttemptEntity</class>
        <class>io.examwave.store.entity.AnswerRecordEntity</class>
        <class>io.examwave.store.entity.AssignmentEntity</class>
        <class>io.examwave.store.entity.AssignmentSubmissionEntity</class>
        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3308/examwave_next?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Asia/Ho_Chi_Minh"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value="root"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.jdbc.time_zone" value="Asia/Ho_Chi_Minh"/>
        </properties>
    </persistence-unit>
</persistence>
